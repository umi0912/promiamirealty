# ===== PRO MIAMI REALTY — переменные окружения =====
# Заполнить в Vercel → Project → Settings → Environment Variables.
# Без них всё работает в ДЕМО-режиме (in-memory + лог в консоль).

# --- Supabase (база заявок) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # Settings → API → service_role (СЕКРЕТНЫЙ, только сервер)

# --- Resend (email) ---
RESEND_API_KEY=re_...                   # resend.com → API Keys
RESEND_FROM=PRO MIAMI REALTY <notify@promiamirealty.com>   # домен должен быть верифицирован в Resend
AGENT_EMAIL=info@promiamirealty.com     # куда падают уведомления о новых заявках

# --- Инбокс агента ---
ADMIN_PASSWORD=замени-на-надёжный-пароль

# --- Stripe (оплата) ---
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_SITE_URL=https://promiamirealty.com

# --- Claude API (реальный AI вместо демо) — позже ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Карта на Search (MapTiler — Google-подобный вид) ---
# Без ключа карта работает на бесплатном CARTO. С ключом MapTiler — более детальный street-вид.
# Ключ: maptiler.com → Account → API keys (бесплатно до 100k загрузок/мес).
NEXT_PUBLIC_MAPTILER_KEY=...

# --- Spark API / BeachesMLS IDX (живые листинги) ---
# Без токена Search работает на демо-данных. Получить: BeachesMLS Agent/Broker Licensed Feed - IDX.
SPARK_ACCESS_TOKEN=...                   # Access Token (СЕКРЕТНЫЙ, только сервер)
SPARK_FEED_ID=...                        # API Feed ID (для идентификации фида в поддержке)
